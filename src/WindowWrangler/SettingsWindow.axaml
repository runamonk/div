<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WindowWrangler.SettingsWindow"
        Title="Window Wrangler Settings"
        Icon="/Assets/WindowWrangler.ico"
        Width="560" Height="640" MinWidth="440" MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Window.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
            <Setter Property="Margin" Value="28,0,0,6" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto">
        <!-- One section per area. New options go in the section they belong to. -->
        <ScrollViewer>
            <StackPanel Margin="24,6,24,24">
                <TextBlock Classes="section" Text="General" />
                <CheckBox x:Name="StartWithWindowsBox" Content="Start with Windows" />

                <TextBlock Classes="section" Text="Snapping" />
                <CheckBox x:Name="SnapWithShiftBox" Content="Hold Shift while dragging to show zones" />
                <TextBlock Classes="note" Text="Turn off to show zones every time you drag a window." />

                <TextBlock Classes="section" Text="Placing new windows" />
                <CheckBox x:Name="RestoreLastKnownBox" Content="Put windows back where the app last was" />
                <TextBlock Classes="note" Text="For apps that don't remember their own position. Apps that do are just nudged into the zone they open in." />

                <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                    <TextBlock Text="How close a window must be to a zone to snap" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" x:Name="ThresholdText" VerticalAlignment="Center" />
                </Grid>
                <Slider x:Name="ThresholdSlider" Minimum="30" Maximum="95" TickFrequency="5" IsSnapToTickEnabled="True" />
                <TextBlock Classes="note" Margin="0,0,0,6" Text="Lower snaps more eagerly; higher leaves more windows floating." />

                <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                    <TextBlock Text="Leave windows alone if already within (pixels)" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="1" x:Name="ToleranceBox" Minimum="0" Maximum="50" Increment="1" FormatString="0" Width="130" />
                </Grid>

                <TextBlock Classes="section" Text="Excluded apps" />
                <TextBlock Classes="note" Margin="0,0,0,8" Text="Never move these. One process name per line, e.g. notepad or notepad.exe." />
                <TextBox x:Name="ExcludedBox" AcceptsReturn="True" TextWrapping="NoWrap" Height="120" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppLineBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Classes="primary action" Content="Save" IsDefault="True" Click="Save_Click" />
                <Button Classes="action" Content="Cancel" IsCancel="True" Click="Cancel_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
