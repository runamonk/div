<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WindowWrangler.App"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FAFAFA" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="AppCardBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppLineBrush" Color="#E0E0E0" />
                    <SolidColorBrush x:Key="AppTextBrush" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="AppMutedBrush" Color="#707070" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#0067C0" />
                    <SolidColorBrush x:Key="AppAccentTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppZoneBrush" Color="#DCDCDC" />
                    <SolidColorBrush x:Key="AppEmptyBrush" Color="#F3F3F3" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#202020" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="AppCardBrush" Color="#2D2D2D" />
                    <SolidColorBrush x:Key="AppLineBrush" Color="#3D3D3D" />
                    <SolidColorBrush x:Key="AppTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppMutedBrush" Color="#A0A0A0" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#60CDFF" />
                    <SolidColorBrush x:Key="AppAccentTextBrush" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="AppZoneBrush" Color="#4A4A4A" />
                    <SolidColorBrush x:Key="AppEmptyBrush" Color="#262626" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        </Style>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,14" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppAccentTextBrush}" />
        </Style>
        <Style Selector="Button.action">
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="14,8" />
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <!-- Layout and monitor cards. -->
        <Style Selector="Border.card, Border.monitor">
            <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Width" Value="214" />
            <Setter Property="Padding" Value="14,10,10,14" />
            <Setter Property="Margin" Value="0,0,14,14" />
        </Style>
        <Style Selector="Border.monitor">
            <Setter Property="Width" Value="128" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style Selector="Border.card:pointerover, Border.monitor:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AppMutedBrush}" />
        </Style>
        <Style Selector="Border.card.selected, Border.monitor.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.badge TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentTextBrush}" />
        </Style>
        <Style Selector="Path.default-corner">
            <Setter Property="Fill" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
        </Style>
        <Style Selector="Border.selected TextBlock.title">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
        </Style>
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/WindowWrangler.ico" ToolTipText="Window Wrangler" Clicked="Tray_Clicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Edit layouts..." Click="EditLayouts_Click" />
                        <NativeMenuItem Header="Settings..." Click="Settings_Click" />
                        <NativeMenuItem Header="Tidy all windows" Click="TidyAll_Click" />
                        <NativeMenuItem Header="Pause" ToggleType="CheckBox" Click="Pause_Click" />
                        <NativeMenuItem Header="Start with Windows" ToggleType="CheckBox" Click="Startup_Click" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Reload settings" Click="ReloadSettings_Click" />
                        <NativeMenuItem Header="Open settings folder" Click="OpenFolder_Click" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Exit" Click="Exit_Click" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
