<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Div.SettingsWindow"
        Title="&lt;div&gt; Settings"
        Icon="/Assets/Div.ico"
        Width="560" Height="640" MinWidth="440" MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Window.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
            <Setter Property="Margin" Value="28,0,0,6" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto">
        <!-- One section per area. New options go in the section they belong to. -->
        <ScrollViewer>
            <StackPanel Margin="24,6,24,24">
                <TextBlock Classes="section" Text="General" />
                <CheckBox x:Name="StartWithWindowsBox" Content="Start with Windows" />
                <CheckBox x:Name="RunAsAdminBox" Content="Run as administrator" Margin="0,6,0,0" />
                <TextBlock Classes="note" Text="So apps that run as admin get managed too. Windows asks for permission when you start it; with Start with Windows on, it starts at sign-in without asking. Turning it off takes effect next time it starts." />

                <TextBlock Classes="section" Text="Snapping" />
                <CheckBox x:Name="SnapWithShiftBox" Content="Snap windows to zones while dragging (hold Shift)" />
                <TextBlock Classes="note" Text="Hold Shift while dragging to show the zones and drop a window into one. Turn off to drag windows freely." />
                <CheckBox x:Name="RestoreSizeBox" Content="Restore a window's own size when dragged out of a zone" />
                <CheckBox x:Name="SquareCornersBox" Content="Square corners on windows in a zone" Margin="0,6,0,0" />
                <TextBlock Classes="note" Text="Windows 11 only. Stops the rounded corners leaving gaps between zoned windows." />

                <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                    <TextBlock Text="Light up both zones this close to their shared edge (pixels)" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <NumericUpDown Grid.Column="1" x:Name="EdgeReachBox" Minimum="0" Maximum="100" Increment="5" FormatString="0" Width="130" />
                </Grid>
                <TextBlock Classes="note" Margin="0,0,0,6" Text="0 turns it off; hold Ctrl while dragging to span zones instead." />

                <CheckBox x:Name="MaximizeToZoneBox" Content="Maximizing a window fills its zone" Margin="0,6,0,0" />
                <TextBlock Classes="note" Text="Maximize again to put it back; hold Shift for the whole screen. Works with the button, a title bar double-click and Win+Up." />

                <CheckBox x:Name="WinArrowsBox" Content="Win+arrow keys move windows between zones" Margin="0,6,0,0" />
                <TextBlock Classes="note" Text="Replaces Windows' own Win+arrow snapping. Where there's no zone that way, Windows still gets the key." />

                <TextBlock Classes="section" Text="Placing new windows" />
                <CheckBox x:Name="RestoreLastKnownBox" Content="Put windows back where the app last was" />
                <TextBlock Classes="note" Text="For apps that don't remember their own position. Apps that do are just nudged into the zone they open in." />

                <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                    <TextBlock Text="Snap a new window into a zone when it's within (pixels)" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <NumericUpDown Grid.Column="1" x:Name="SnapDistanceBox" Minimum="0" Maximum="500" Increment="5" FormatString="0" Width="130" />
                </Grid>
                <TextBlock Classes="note" Margin="0,0,0,6" Text="Every edge has to be that close to the zone's. Higher catches apps that open further off; 0 turns it off." />

                <TextBlock Classes="section" Text="Excluded apps" />
                <TextBlock Classes="note" Margin="0,0,0,8" Text="Never move these. One process name per line, e.g. notepad or notepad.exe." />
                <TextBox x:Name="ExcludedBox" AcceptsReturn="True" TextWrapping="NoWrap" Height="120" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppLineBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Classes="primary action" Content="Save" IsDefault="True" Click="Save_Click" />
                <Button Classes="action" Content="Cancel" IsCancel="True" Click="Cancel_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
