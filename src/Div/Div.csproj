<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Div.ico</ApplicationIcon>
    <AssemblyTitle>&lt;div&gt;</AssemblyTitle>
    <Product>&lt;div&gt;</Product>
    <Description>Puts windows back where they belong.</Description>
    <Version>0.0.0-dev</Version>
    <!-- Compile ahead of time when publishing: faster start, and the hooks never wait on the JIT. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <!-- Built from native/DivHook.c by native/build.ps1; committed so a plain build works. -->
    <None Include="..\..\native\DivHook.dll" Link="DivHook.dll" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Div.Core\Div.Core.csproj" />
  </ItemGroup>
</Project>
